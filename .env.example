# Copy this file to `.env` and adjust values as needed.  All settings are
# loaded from the environment on startup; the UI only allows changing the
# scheduling strategy.  Restart the server after modifying any value.

# Domain for the self-hosted setup (used by Caddy for automatic HTTPS).
# Leave blank for local/HTTP-only use (http://localhost).
# Set to your domain (e.g. myapp.com) on a VPS for automatic Let's Encrypt certs.
CADDY_HOST=

# Database connection (Postgres by default)
# if you're using `docker-compose.yml` locally you can leave this value as-is;
# the compose file will set `DATABASE_URL` to point at the database container.
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5433/quickly

# Application URL (used for OAuth redirects, links, etc.)
BASE_URL=http://localhost:8000

# Google OAuth credentials (required — Gmail is the only email provider)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Background job interval
QUEUE_CHECK_INTERVAL_MINUTES=1

# Test mode (true/false)
# NOTE: test mode is now managed via the web UI on the Settings page. The
# environment variable is only consulted the very first time the application
# starts and after that the value live in the database. You can safely remove
# this line in most deployments.
#TEST_MODE=true

# Time offset (days) for testing; 0 means real time
# NOTE: this environment variable is only used during application startup
# to set the *initial* offset value.  Once the app has run, the offset is
# persisted to the database and subsequently managed by the server or the
# smoke_test scripts.  You can safely remove it from your venv/.env – the
# simulation script will control the offset instead.
TIME_OFFSET_DAYS=0

# Gmail sync configuration (optional)
GMAIL_PUSH_TOPIC=
GMAIL_PUSH_WEBHOOK_TOKEN=
GMAIL_REPLY_SYNC_INTERVAL_MINUTES=5
