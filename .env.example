# Database (default: SQLite)
# DATABASE_URL=sqlite+aiosqlite:///./campaign.db

# Email provider: "resend" or "smtp"
EMAIL_PROVIDER=resend

# Resend.com (https://resend.com/api-keys) - required when EMAIL_PROVIDER=resend
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# SMTP - used when EMAIL_PROVIDER=smtp
# SMTP_HOST=localhost
# SMTP_PORT=1025
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_USE_TLS=false

# Background job: how often to check for due emails (minutes, default 1)
# QUEUE_CHECK_INTERVAL_MINUTES=1

# Test mode: queue emails for manual approval (no send until you run approval from Python console)
# TEST_MODE=true
