# ============================================================
# Quickly – Environment Configuration
# Copy this file to `.env` and fill in the values below.
# Most settings (test mode, time offset, Gmail sync, etc.) are
# managed through the Settings page in the web UI after startup.
# ============================================================

# ── Infrastructure ───────────────────────────────────────────

# Domain for the self-hosted setup (used by Caddy for automatic HTTPS).
# Leave blank for local / HTTP-only use (http://localhost).
# Set to your domain (e.g. myapp.com) on a VPS for automatic Let's Encrypt certs.
CADDY_HOST=

# Application base URL (used for OAuth redirects, email links, etc.)
BASE_URL=http://localhost:8000

# ── Google OAuth ─────────────────────────────────────────────
# Required to enable Gmail inbox connections.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── Microsoft / Office 365 OAuth ─────────────────────────────
# Required to enable Office 365 inbox connections.
OFFICE365_CLIENT_ID=
OFFICE365_CLIENT_SECRET=
# Use 'common' for multi-tenant (any Microsoft account), or your specific tenant ID.
OFFICE365_TENANT_ID=common

# ── Generic SMTP inboxes ─────────────────────────────────────────
# SMTP/IMAP credentials themselves are stored per-inbox via the UI or API
# (see INSTALL.md Step 3C). These flags only tune validation:
# Allow SMTP/IMAP hosts that resolve to private/internal addresses
# (self-hosted relays, Mailpit, local test doubles). Default: refuse.
# SMTP_ALLOW_PRIVATE_HOSTS=true
# Allow plaintext SMTP with neither STARTTLS nor implicit SSL (local
# relay doubles only — passwords go over the wire in cleartext). Default: refuse.
# SMTP_ALLOW_PLAIN_SMTP=true
# Socket timeout (seconds) for SMTP send + IMAP sync operations. A relay that
# accepts the connection but stops responding is abandoned after this.
# Default: 30 for SMTP sends, 15 for IMAP sync; set one value to override both.
# SMTP_TIMEOUT_SECONDS=30

# ── Precleared cold-email check ──────────────────────────────
# Before the first email of a campaign goes to a lead, Quickly asks
# precleared.dev whether a cold email to that address is allowed where the
# lead is (UK PECR, US CAN-SPAM, Canada's CASL and others) and holds the
# lead when it is not. Follow-ups and test-mode sends are not checked.
#   hold (default): send only on ok_to_email; pause the lead otherwise.
#   warn: record the verdict and send anyway.   off: no check.
# PRECLEARED_MODE=hold
# Optional. Without a key Precleared allows 10 checks a day per network; when
# that runs out Quickly asks for a free key once (with the sending inbox's
# address) and stores it in the app_setting table. Free keys: https://precleared.dev/get-key
# PRECLEARED_API_KEY=
# Where the sending business is based: GB (default), US or AE.
# PRECLEARED_SENDER_COUNTRY=GB

# ── Anonymous usage telemetry ─────────────────────────────────
# Opt-out aggregate usage stats, enabled by default. It sends coarse install
# scale — RAM rounded up to whole GB, logical CPU count, docker/bare deployment,
# OS family (linux/windows/macos) and CPU family (x86_64/arm64/...) — plus
# aggregate counts (leads/campaigns/inboxes, per-day send/open/click/reply
# totals, milestones, feature use). It does not send hostnames, exact OS/kernel
# or disk details, environment variables, IPs, or lead/person content. Set
# QUICKLY_TELEMETRY=false to turn it off.
QUICKLY_TELEMETRY=true
# Official release images bake the hub URL and write key. This file is loaded
# with `env_file:`, which overrides the image, so keep the key and version
# commented out unless you are overriding them yourself. Never commit a real key.
QUICKLY_TELEMETRY_URL=https://telemetry.shortformfunnels.com
# QUICKLY_TELEMETRY_KEY=
# QUICKLY_VERSION=unknown

# ── CORS ─────────────────────────────────────────────────────
# Comma-separated list of allowed origins. Defaults to localhost dev setup.
CORS_ORIGINS=http://localhost:5173,http://localhost:8000

# ── Vite Dev Server ──────────────────────────────────────────
# Extra hostnames Vite accepts in dev mode (comma-separated).
# Add your dev domain(s) here if you access the Vite dev server
# through a reverse proxy or custom hostname.
VITE_ALLOWED_HOSTS=
 
# only for tests and development 
# QUICKLY_MODE=development # development, production
# DATABASE_URL=postgresql://postgres:postgres@localhost:5433/quickly

# Prebuilt Docker image sets QUICKLY_PREBUILT_IMAGE=1 (inbox UI uses Beacon for custom tracking hostnames).
# Host-Caddy / not-host compose sets QUICKLY_PREBUILT_IMAGE=0. Override with:
# QUICKLY_TRACKING_CNAME_UI=1   # show legacy CNAME-to-Quickly tracking UI even on prebuilt image
