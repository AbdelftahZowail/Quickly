# ============================================================
# Quickly – Environment Configuration
# Copy this file to `.env` and fill in the values below.
# Most settings (test mode, time offset, Gmail sync, etc.) are
# managed through the Settings page in the web UI after startup.
# ============================================================

# ── Infrastructure ───────────────────────────────────────────

# Domain for the self-hosted setup (used by Caddy for automatic HTTPS).
# Leave blank for local / HTTP-only use (http://localhost).
# Set to your domain (e.g. myapp.com) on a VPS for automatic Let's Encrypt certs.
CADDY_HOST=

# Application base URL (used for OAuth redirects, email links, etc.)
BASE_URL=http://localhost:8000

# ── Google OAuth ─────────────────────────────────────────────
# Required to enable Gmail inbox connections.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── Microsoft / Office 365 OAuth ─────────────────────────────
# Required to enable Office 365 inbox connections.
OFFICE365_CLIENT_ID=
OFFICE365_CLIENT_SECRET=
# Use 'common' for multi-tenant (any Microsoft account), or your specific tenant ID.
OFFICE365_TENANT_ID=common

# ── CORS ─────────────────────────────────────────────────────
# Comma-separated list of allowed origins. Defaults to localhost dev setup.
CORS_ORIGINS=http://localhost:5173,http://localhost:8000
 
# only for tests and development 
# QUICKLY_MODE=development # development, production

# ── Database ─────────────────────────────────────────────────
# Local / Compose: often set by docker-compose; override only for external Postgres.
# DATABASE_URL=postgresql://postgres:postgres@localhost:5433/quickly
#
# PaaS (Railway, Render, Fly.io, Neon, etc.): set DATABASE_URL on the *app* service
# (reference your provider’s Postgres variable, e.g. ${{ Postgres.DATABASE_URL }} on Railway).
#
# Managed Postgres often uses TLS on a proxy hostname that does not match the TLS certificate.
# Quickly then enables encrypted connections without verifying the cert hostname:
#   • Railway (rlwy.net, railway.internal, *.railway.app, or private IP when RAILWAY_ENVIRONMENT is set): automatic.
#   • Other providers: set QUICKLY_DATABASE_SSL_RELAXED=1 (or true / yes / on).
# Leave unset for normal Postgres where the hostname matches the certificate (typical VPS/Compose).
# QUICKLY_DATABASE_SSL_RELAXED=1

# Prebuilt Docker image sets QUICKLY_PREBUILT_IMAGE=1 (inbox UI uses Beacon for custom tracking hostnames).
# Host-Caddy / not-host compose sets QUICKLY_PREBUILT_IMAGE=0. Override with:
# QUICKLY_TRACKING_CNAME_UI=1   # show legacy CNAME-to-Quickly tracking UI even on prebuilt image
